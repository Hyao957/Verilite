{
  "name": "verilite",
  "displayName": "VeriLite - Verilog & SystemVerilog Support",
  "description": "Verilog and SystemVerilog editing with syntax highlighting, completion, lightweight error checking and formatting - no external toolchain required.",
  "version": "0.3.0",
  "publisher": "publisher",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-name/verilite-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/your-name/verilite-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "verilog",
    "systemverilog",
    "hdl",
    "fpga",
    "rtl"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:verilog",
    "onLanguage:systemverilog"
  ],
  "contributes": {
    "languages": [
      {
        "id": "verilog",
        "aliases": [
          "Verilog",
          "verilog"
        ],
        "extensions": [
          ".v",
          ".vh",
          ".vl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "systemverilog",
        "aliases": [
          "SystemVerilog",
          "systemverilog"
        ],
        "extensions": [
          ".sv",
          ".svh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "verilog",
        "scopeName": "source.verilog",
        "path": "./syntaxes/verilog.tmLanguage.json"
      },
      {
        "language": "systemverilog",
        "scopeName": "source.systemverilog",
        "path": "./syntaxes/systemverilog.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "verilog",
        "path": "./snippets/verilog.json"
      },
      {
        "language": "systemverilog",
        "path": "./snippets/systemverilog.json"
      },
      {
        "language": "verilog",
        "path": "./snippets/verilog-vivado-attributes.json"
      }
    ],
    "commands": [
      {
        "command": "verilite.lintNow",
        "title": "VeriLite: Check Current File"
      },
      {
        "command": "verilite.clearDiagnostics",
        "title": "VeriLite: Clear All Diagnostics"
      },
      {
        "command": "verilite.insertHeader",
        "title": "VeriLite: Insert File Header"
      },
      {
        "command": "verilite.alignSelection",
        "title": "VeriLite: Align Selection"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "verilite.lintNow",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "verilite.clearDiagnostics",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "verilite.insertHeader",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        },
        {
          "command": "verilite.alignSelection",
          "when": "editorLangId == verilog || editorLangId == systemverilog"
        }
      ]
    },
    "keybindings": [
      {
        "command": "verilite.alignSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && (editorLangId == verilog || editorLangId == systemverilog)"
      }
    ],
    "configuration": {
      "title": "VeriLite",
      "properties": {
        "verilite.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable VeriLite error checking.",
          "scope": "language-overridable"
        },
        "verilite.lint.runOn": {
          "type": "string",
          "enum": [
            "type",
            "save",
            "manual"
          ],
          "enumDescriptions": [
            "Check while typing (debounced)",
            "Check only on save",
            "Check only via the VeriLite: Check Current File command"
          ],
          "default": "type",
          "description": "When to run the checker.",
          "scope": "language-overridable"
        },
        "verilite.lint.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay in milliseconds before re-checking while typing.",
          "scope": "language-overridable"
        },
        "verilite.lint.maxIssues": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Maximum number of diagnostics reported per file.",
          "scope": "language-overridable"
        },
        "verilite.lint.warnMissingDefault": {
          "type": "boolean",
          "default": true,
          "description": "Warn when a case statement has no default branch.",
          "scope": "language-overridable"
        },
        "verilite.lint.warnBlockingInSeq": {
          "type": "boolean",
          "default": true,
          "description": "Warn about blocking assignments in sequential blocks and non-blocking assignments in combinational blocks.",
          "scope": "language-overridable"
        },
        "verilite.lint.warnAlwaysNoSensitivity": {
          "type": "boolean",
          "default": true,
          "description": "Warn when an always block has no sensitivity list. Turn this off if you write a lot of testbenches.",
          "scope": "language-overridable"
        },
        "verilite.lint.hintTrailingWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Show a hint on lines with trailing whitespace.",
          "scope": "language-overridable"
        },
        "verilite.format.indentStyle": {
          "type": "string",
          "enum": [
            "space",
            "tab"
          ],
          "default": "space",
          "description": "Indent using spaces or tabs.",
          "scope": "language-overridable"
        },
        "verilite.format.indentSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 8,
          "description": "Number of spaces per indent level.",
          "scope": "language-overridable"
        },
        "verilite.format.alignPorts": {
          "type": "boolean",
          "default": true,
          "description": "Column-align consecutive port declarations.",
          "scope": "language-overridable"
        },
        "verilite.format.alignAssignments": {
          "type": "boolean",
          "default": false,
          "description": "Column-align the '=' of consecutive assign statements.",
          "scope": "language-overridable"
        },
        "verilite.format.spaceAroundOperators": {
          "type": "boolean",
          "default": true,
          "description": "Put one space around unambiguous binary operators such as = <= == &&.",
          "scope": "language-overridable"
        },
        "verilite.format.joinBegin": {
          "type": "boolean",
          "default": true,
          "description": "Merge a 'begin' that sits alone on its line up onto its control head, e.g. 'always @(...)\\nbegin' becomes 'always @(...) begin'.",
          "scope": "language-overridable"
        },
        "verilite.format.alignIfElse": {
          "type": "boolean",
          "default": true,
          "description": "Column-align the bodies of consecutive single-statement if / else if / else branches (branches that use begin/end keep the normal indentation).",
          "scope": "language-overridable"
        },
        "verilite.format.alignDeclarations": {
          "type": "boolean",
          "default": true,
          "description": "Column-align consecutive net / variable declarations (wire, reg, logic, ...), lining up the signal names the way port declarations are aligned.",
          "scope": "language-overridable"
        },
        "verilite.format.alignParams": {
          "type": "boolean",
          "default": true,
          "description": "Column-align the '=' of consecutive parameter / localparam initialisations.",
          "scope": "language-overridable"
        },
        "verilite.format.alignDeclAssignments": {
          "type": "boolean",
          "default": true,
          "description": "Column-align the '=' of consecutive initialized declarations (wire/reg/logic with =).",
          "scope": "language-overridable"
        },
        "verilite.format.alignInstancePorts": {
          "type": "boolean",
          "default": true,
          "description": "Column-align .port_name(value) connections in module instantiations and remove blank lines between them.",
          "scope": "language-overridable"
        },
        "verilite.format.alignBlockAssignments": {
          "type": "boolean",
          "default": true,
          "description": "Column-align consecutive assignments (<= / =) inside procedural blocks.",
          "scope": "language-overridable"
        },
        "verilite.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable keyword and symbol completion.",
          "scope": "language-overridable"
        },
        "verilite.completion.includeSystemTasks": {
          "type": "boolean",
          "default": true,
          "description": "Include system tasks such as $display in completion results.",
          "scope": "language-overridable"
        },
        "verilite.lint.external": {
          "type": "string",
          "enum": [
            "none",
            "iverilog",
            "verilator"
          ],
          "default": "none",
          "description": "Reserved for v0.2. External compiler used for deep checking. Not implemented in v0.1.",
          "scope": "language-overridable"
        },
        "verilite.lint.externalPath": {
          "type": "string",
          "default": "",
          "description": "Reserved for v0.2. Path to the external compiler executable.",
          "scope": "language-overridable"
        },
        "verilite.format.external": {
          "type": "string",
          "enum": [
            "none",
            "verible"
          ],
          "default": "none",
          "description": "Reserved for v0.2. External formatter. Not implemented in v0.1.",
          "scope": "language-overridable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test out-test/test/unit/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  }
}
