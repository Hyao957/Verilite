{
  "SystemVerilog module": {
    "prefix": "module",
    "body": [
      "module ${1:name} #(",
      "\tparameter int ${2:WIDTH} = ${3:8}",
      ") (",
      "\tinput  logic                  clk,",
      "\tinput  logic                  rst_n,",
      "\tinput  logic [${2:WIDTH}-1:0] din,",
      "\toutput logic [${2:WIDTH}-1:0] dout",
      ");",
      "",
      "\t$0",
      "",
      "endmodule"
    ],
    "description": "SystemVerilog \u6a21\u5757\u9aa8\u67b6"
  },
  "Always combinational": {
    "prefix": "always_comb",
    "body": [
      "always_comb begin",
      "\t${1:out} = ${2:'0};",
      "\t$0",
      "end"
    ],
    "description": "SystemVerilog \u7ec4\u5408\u903b\u8f91\u5757"
  },
  "Always flip-flop": {
    "prefix": "always_ff",
    "body": [
      "always_ff @(posedge ${1:clk} or negedge ${2:rst_n}) begin",
      "\tif (!${2:rst_n}) begin",
      "\t\t${3:q} <= ${4:'0};",
      "\tend else begin",
      "\t\t$0",
      "\tend",
      "end"
    ],
    "description": "SystemVerilog \u65f6\u5e8f\u903b\u8f91\u5757"
  },
  "Always latch": {
    "prefix": "always_latch",
    "body": [
      "always_latch begin",
      "\tif (${1:enable}) begin",
      "\t\t${2:q} <= ${3:d};",
      "\tend",
      "end"
    ],
    "description": "SystemVerilog \u9501\u5b58\u5668\u5757"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:name} (",
      "\tinput logic ${2:clk}",
      ");",
      "\tlogic ${3:valid};",
      "\tlogic ${4:ready};",
      "",
      "\tmodport ${5:master} (output ${3:valid}, input ${4:ready});",
      "\tmodport ${6:slave}  (input ${3:valid}, output ${4:ready});",
      "endinterface"
    ],
    "description": "SystemVerilog interface \u4e0e modport"
  },
  "Package": {
    "prefix": "package",
    "body": [
      "package ${1:name}_pkg;",
      "\t$0",
      "endpackage"
    ],
    "description": "SystemVerilog package"
  },
  "Package import": {
    "prefix": "import",
    "body": [
      "import ${1:package_name}::${2:*};"
    ],
    "description": "\u5bfc\u5165 SystemVerilog package \u6210\u5458"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:name};",
      "\t$0",
      "endclass"
    ],
    "description": "SystemVerilog class"
  },
  "Class with constructor": {
    "prefix": "classnew",
    "body": [
      "class ${1:name};",
      "\tfunction new(${2});",
      "\t\t$0",
      "\tendfunction",
      "endclass"
    ],
    "description": "\u5e26\u6784\u9020\u51fd\u6570\u7684 SystemVerilog class"
  },
  "Typedef enum": {
    "prefix": "typedefenum",
    "body": [
      "typedef enum logic [${1:1}:0] {",
      "\t${2:IDLE},",
      "\t${3:RUN},",
      "\t${4:DONE}",
      "} ${5:state_t};"
    ],
    "description": "SystemVerilog \u679a\u4e3e\u7c7b\u578b"
  },
  "Typedef packed struct": {
    "prefix": "typedefstruct",
    "body": [
      "typedef struct packed {",
      "\tlogic [${1:7}:0] ${2:data};",
      "\tlogic           ${3:valid};",
      "} ${4:item_t};"
    ],
    "description": "SystemVerilog packed struct"
  },
  "Logic declaration": {
    "prefix": "logic",
    "body": [
      "logic [${1:WIDTH}-1:0] ${2:name};"
    ],
    "description": "SystemVerilog logic \u58f0\u660e"
  },
  "Automatic function": {
    "prefix": "function",
    "body": [
      "function automatic ${1:logic} ${2:name}(",
      "\tinput ${3:logic} ${4:arg}",
      ");",
      "\t$0",
      "endfunction"
    ],
    "description": "SystemVerilog automatic function"
  },
  "Automatic task": {
    "prefix": "task",
    "body": [
      "task automatic ${1:name}(",
      "\tinput ${2:logic} ${3:arg}",
      ");",
      "\t$0",
      "endtask"
    ],
    "description": "SystemVerilog automatic task"
  },
  "Foreach loop": {
    "prefix": "foreach",
    "body": [
      "foreach (${1:array}[${2:i}]) begin",
      "\t$0",
      "end"
    ],
    "description": "SystemVerilog foreach \u5faa\u73af"
  },
  "Constraint block": {
    "prefix": "constraint",
    "body": [
      "constraint ${1:name}_c {",
      "\t${2:value} inside {[$3:$4]};",
      "}"
    ],
    "description": "SystemVerilog \u968f\u673a\u7ea6\u675f"
  },
  "Concurrent assertion": {
    "prefix": "assertp",
    "body": [
      "${1:label}: assert property (@(posedge ${2:clk}) disable iff (!${3:rst_n})",
      "\t${4:req} |-> ##${5:1} ${6:ack}",
      ") else \\$error(\"${7:assertion failed}\");"
    ],
    "description": "SystemVerilog \u5e76\u53d1\u65ad\u8a00"
  },
  "Property": {
    "prefix": "property",
    "body": [
      "property ${1:name};",
      "\t@(posedge ${2:clk}) disable iff (!${3:rst_n})",
      "\t${4:req} |-> ##${5:1} ${6:ack};",
      "endproperty"
    ],
    "description": "SystemVerilog property"
  },
  "Covergroup": {
    "prefix": "covergroup",
    "body": [
      "covergroup ${1:name} @(posedge ${2:clk});",
      "\t${3:cp}: coverpoint ${4:signal};",
      "endgroup"
    ],
    "description": "SystemVerilog covergroup"
  },
  "Clocking block": {
    "prefix": "clocking",
    "body": [
      "clocking ${1:cb} @(posedge ${2:clk});",
      "\tdefault input #1step output #0;",
      "\tinput  ${3:input_signal};",
      "\toutput ${4:output_signal};",
      "endclocking"
    ],
    "description": "SystemVerilog clocking block"
  },
  "Mailbox": {
    "prefix": "mailbox",
    "body": [
      "mailbox #(${1:int}) ${2:mbx} = new();",
      "",
      "initial begin",
      "\t${2:mbx}.put(${3:item});",
      "\t${2:mbx}.get(${4:item});",
      "end"
    ],
    "description": "SystemVerilog mailbox \u58f0\u660e\u4e0e\u6536\u53d1"
  },
  "Semaphore": {
    "prefix": "semaphore",
    "body": [
      "semaphore ${1:sem} = new(${2:1});",
      "",
      "initial begin",
      "\t${1:sem}.get();",
      "\t$0",
      "\t${1:sem}.put();",
      "end"
    ],
    "description": "SystemVerilog semaphore \u7533\u8bf7\u4e0e\u91ca\u653e"
  },
  "Random class": {
    "prefix": "rand",
    "body": [
      "class ${1:packet};",
      "\trand  bit [${2:7}:0] ${3:data};",
      "\trandc bit [${4:1}:0] ${5:kind};",
      "",
      "\tconstraint ${1:packet}_c {",
      "\t\t${3:data} inside {[${6:0}:${7:255}]};",
      "\t\t${5:kind} dist { 0 := 1, 1 := 3 };",
      "\t}",
      "",
      "\tfunction void check_randomize();",
      "\t\tif (!randomize()) \\$error(\"randomize failed\");",
      "\t\t\\$display(\"${3:data}=%0d\", ${3:data});",
      "\tendfunction",
      "endclass"
    ],
    "description": "\u5e26 rand/randc\u3001\u7ea6\u675f\u4e0e randomize \u7684\u968f\u673a\u7c7b"
  },
  "Class extends": {
    "prefix": "extends",
    "body": [
      "class ${1:child} extends ${2:base};",
      "\tfunction new();",
      "\t\tsuper.new();",
      "\t\t$0",
      "\tendfunction",
      "endclass"
    ],
    "description": "\u7ee7\u627f\u7236\u7c7b\u7684 SystemVerilog class"
  },
  "Virtual interface": {
    "prefix": "virtual",
    "body": [
      "virtual ${1:bus_if} ${2:vif};"
    ],
    "description": "SystemVerilog \u865a\u63a5\u53e3\u53e5\u67c4"
  },
  "Modport": {
    "prefix": "modport",
    "body": [
      "modport ${1:master} (${2:output} ${3:valid}, ${4:input} ${5:ready});"
    ],
    "description": "SystemVerilog interface modport"
  },
  "Constraint with dist": {
    "prefix": "constraintdist",
    "body": [
      "constraint ${1:name}_c {",
      "\tsolve ${2:kind} before ${3:value};",
      "\t${3:value} inside {[${4:0}:${5:15}]};",
      "\t${2:kind} dist { 0 := ${6:1}, 1 := ${7:3} };",
      "}"
    ],
    "description": "\u5e26 inside/dist/solve \u7684\u968f\u673a\u7ea6\u675f"
  },
  "SystemVerilog testbench": {
    "prefix": "tb",
    "body": [
      "`timescale 1ns / 1ps",
      "",
      "module ${1:dut}_tb;",
      "\ttimeunit 1ns;",
      "\ttimeprecision 1ps;",
      "",
      "\tlogic clk = 1'b0;",
      "\tlogic rst_n = 1'b0;",
      "",
      "\talways #${2:5ns} clk = ~clk;",
      "",
      "\t${1:dut} dut (.*);",
      "",
      "\tinitial begin",
      "\t\trepeat (${3:5}) @(posedge clk);",
      "\t\trst_n = 1'b1;",
      "\t\t$0",
      "\t\t\\$finish;",
      "\tend",
      "endmodule"
    ],
    "description": "SystemVerilog \u81ea\u68c0\u6d4b\u8bd5\u5e73\u53f0\u9aa8\u67b6"
  }
}
