{
	"Module skeleton": {
		"prefix": "module",
		"body": [
			"module ${1:name} #(",
			"\tparameter ${2:WIDTH} = ${3:8}",
			") (",
			"\tinput  wire                  clk,",
			"\tinput  wire                  rst_n,",
			"\tinput  wire [${2:WIDTH}-1:0] din,",
			"\toutput reg  [${2:WIDTH}-1:0] dout",
			");",
			"",
			"\t$0",
			"",
			"endmodule"
		],
		"description": "模块骨架 · 带参数与端口"
	},
	"Module skeleton with ports only": {
		"prefix": "modulep",
		"body": [
			"module ${1:name} (",
			"\tinput  wire clk,",
			"\tinput  wire rst_n,",
			"\tinput  wire ${2:din},",
			"\toutput reg  ${3:dout}",
			");",
			"",
			"\t$0",
			"",
			"endmodule"
		],
		"description": "模块骨架 · 只带端口，无参数列表"
	},
	"Bare module skeleton": {
		"prefix": "moduleb",
		"body": [
			"module ${1:name};",
			"",
			"\t$0",
			"",
			"endmodule"
		],
		"description": "模块骨架 · 裸版，无参数无端口"
	},

	"Module instantiation with parameters": {
		"prefix": "inst",
		"body": [
			"${1:module_name} #(",
			"\t.${2:WIDTH} (${3:8})",
			") ${4:u_inst} (",
			"\t.clk       (clk),",
			"\t.rst_n     (rst_n),",
			"\t.${5:din}  (${6:din}),",
			"\t.${7:dout} (${8:dout})",
			");"
		],
		"description": "例化 · 带参数"
	},
	"Module instantiation without parameters": {
		"prefix": "instb",
		"body": [
			"${1:module_name} ${2:u_inst} (",
			"\t.clk       (clk),",
			"\t.rst_n     (rst_n),",
			"\t.${3:din}  (${4:din}),",
			"\t.${5:dout} (${6:dout})",
			");"
		],
		"description": "例化 · 无参数"
	},

	"Begin end block": {
		"prefix": "begin",
		"body": [
			"begin",
			"\t$0",
			"end"
		],
		"description": "begin / end 空块"
	},
	"If block": {
		"prefix": "if",
		"body": [
			"if (${1:cond}) begin",
			"\t$0",
			"end"
		],
		"description": "if 带 begin-end"
	},
	"Else if block": {
		"prefix": "elseif",
		"body": [
			"else if (${1:cond}) begin",
			"\t$0",
			"end"
		],
		"description": "else if 带 begin-end"
	},
	"If else": {
		"prefix": "ifelse",
		"body": [
			"if (${1:cond}) begin",
			"\t${2}",
			"end else begin",
			"\t${3}",
			"end"
		],
		"description": "if / else 带 begin-end"
	},
	"Case statement": {
		"prefix": "case",
		"body": [
			"case (${1:sel})",
			"\t${2:2'b00}: ${3:out = 1'b0;}",
			"\t${4:2'b01}: ${5:out = 1'b1;}",
			"\tdefault:   ${6:out = 1'b0;}",
			"endcase"
		],
		"description": "case 语句 · 两分支加 default"
	},
	"Casez statement": {
		"prefix": "casez",
		"body": [
			"casez (${1:sel})",
			"\t${2:4'b1???}: ${3:out = 2'd0;}",
			"\t${4:4'b01??}: ${5:out = 2'd1;}",
			"\tdefault:     ${6:out = 2'd0;}",
			"endcase"
		],
		"description": "casez 语句 · ? 为无关位，常用于优先级编码"
	},
	"For loop": {
		"prefix": "for",
		"body": [
			"integer ${1:i};",
			"for (${1:i} = 0; ${1:i} < ${2:N}; ${1:i} = ${1:i} + 1) begin",
			"\t$0",
			"end"
		],
		"description": "for 循环 · 含 integer 索引声明"
	},
	"While loop": {
		"prefix": "while",
		"body": [
			"while (${1:cond}) begin",
			"\t$0",
			"end"
		],
		"description": "while 循环"
	},
	"Repeat loop": {
		"prefix": "repeat",
		"body": [
			"repeat (${1:N}) begin",
			"\t$0",
			"end"
		],
		"description": "repeat 循环 · 固定次数"
	},
	"Forever loop": {
		"prefix": "forever",
		"body": [
			"forever begin",
			"\t#${1:5};",
			"\t$0",
			"end"
		],
		"description": "forever 循环 · 需含延时，仅用于仿真"
	},
	"Generate for loop": {
		"prefix": "genfor",
		"body": [
			"genvar ${1:i};",
			"generate",
			"\tfor (${1:i} = 0; ${1:i} < ${2:N}; ${1:i} = ${1:i} + 1) begin : ${3:gen_block}",
			"\t\t$0",
			"\tend",
			"endgenerate"
		],
		"description": "generate-for 具名块"
	},
	"Generate if": {
		"prefix": "genif",
		"body": [
			"generate",
			"\tif (${1:PARAM} == ${2:1}) begin : ${3:gen_true}",
			"\t\t$0",
			"\tend else begin : ${4:gen_false}",
			"\t\t",
			"\tend",
			"endgenerate"
		],
		"description": "generate-if 条件例化 · 具名块"
	},
	"Initial block": {
		"prefix": "initial",
		"body": [
			"initial begin",
			"\t$0",
			"end"
		],
		"description": "initial 块"
	},

	"Always block on clock edge": {
		"prefix": "always",
		"body": [
			"always @(posedge ${1:clk}) begin",
			"\t$0",
			"end"
		],
		"description": "时序块 · 纯同步，无复位"
	},
	"Combinational always block": {
		"prefix": "alwaysc",
		"body": [
			"always @(*) begin",
			"\t${1:out} = ${2:1'b0};",
			"\t$0",
			"end"
		],
		"description": "组合块 · @(*) 带默认赋值"
	},
	"Sequential always block with reset": {
		"prefix": "alwaysr",
		"body": [
			"always @(posedge ${1:clk} or negedge ${2:rst_n}) begin",
			"\tif (!${2:rst_n}) begin",
			"\t\t${3:q} <= ${4:1'b0};",
			"\tend else begin",
			"\t\t$0",
			"\tend",
			"end"
		],
		"description": "时序块 · 带异步低有效复位"
	},
	"Sequential always block with sync reset": {
		"prefix": "alwaysrs",
		"body": [
			"always @(posedge ${1:clk}) begin",
			"\tif (${2:rst}) begin",
			"\t\t${3:q} <= ${4:1'b0};",
			"\tend else begin",
			"\t\t$0",
			"\tend",
			"end"
		],
		"description": "时序块 · 带同步高有效复位"
	},

	"Function": {
		"prefix": "function",
		"body": [
			"function ${1:[7:0]} ${2:name};",
			"\tinput ${3:[7:0]} ${4:arg};",
			"\tbegin",
			"\t\t${2:name} = ${5:arg};",
			"\tend",
			"endfunction"
		],
		"description": "Verilog-2001 函数"
	},
	"Task": {
		"prefix": "task",
		"body": [
			"task ${1:name};",
			"\tinput ${2:arg};",
			"\tbegin",
			"\t\t$0",
			"\tend",
			"endtask"
		],
		"description": "task 骨架"
	},

	"Three-process FSM": {
		"prefix": "fsm",
		"body": [
			"localparam ${1:IDLE} = 2'd0;",
			"localparam ${2:RUN}  = 2'd1;",
			"localparam ${3:DONE} = 2'd2;",
			"",
			"reg [1:0] cur_state, next_state;",
			"",
			"// 1. 状态寄存",
			"always @(posedge ${4:clk} or negedge ${5:rst_n}) begin",
			"\tif (!${5:rst_n}) cur_state <= ${1:IDLE};",
			"\telse            cur_state <= next_state;",
			"end",
			"",
			"// 2. 次态逻辑",
			"always @(*) begin",
			"\tnext_state = cur_state;",
			"\tcase (cur_state)",
			"\t\t${1:IDLE}: if (${6:start}) next_state = ${2:RUN};",
			"\t\t${2:RUN} : if (${7:done})  next_state = ${3:DONE};",
			"\t\t${3:DONE}: next_state = ${1:IDLE};",
			"\t\tdefault  : next_state = ${1:IDLE};",
			"\tendcase",
			"end",
			"",
			"// 3. 输出逻辑",
			"always @(*) begin",
			"\t${8:busy} = (cur_state == ${2:RUN});",
			"end"
		],
		"description": "三段式状态机"
	},

	"Wire declaration": {
		"prefix": "wire",
		"body": ["wire [${1:WIDTH}-1:0] ${2:name};"],
		"description": "wire 声明 · 带位宽"
	},
	"Reg declaration": {
		"prefix": "reg",
		"body": ["reg  [${1:WIDTH}-1:0] ${2:name};"],
		"description": "reg 声明 · 带位宽"
	},
	"Integer declaration": {
		"prefix": "integer",
		"body": ["integer ${1:i};"],
		"description": "integer 声明 · 循环索引或仿真变量"
	},
	"Genvar declaration": {
		"prefix": "genvar",
		"body": ["genvar ${1:i};"],
		"description": "genvar 声明 · generate 循环索引"
	},
	"Real declaration": {
		"prefix": "real",
		"body": ["real ${1:name};"],
		"description": "real 声明 · 仿真用浮点变量"
	},
	"Parameter": {
		"prefix": "param",
		"body": ["parameter ${1:NAME} = ${2:value};"],
		"description": "parameter 声明"
	},
	"Localparam": {
		"prefix": "lparam",
		"body": ["localparam ${1:NAME} = ${2:value};"],
		"description": "localparam 声明"
	},
	"Port declaration": {
		"prefix": "port",
		"body": ["${1|input,output,inout|} wire [${2:WIDTH}-1:0] ${3:name},"],
		"description": "端口声明 · 方向可选"
	},

	"Continuous assign": {
		"prefix": "assign",
		"body": ["assign ${1:out} = ${2:in};"],
		"description": "连续赋值"
	},
	"Assign with ternary": {
		"prefix": "assignt",
		"body": ["assign ${1:out} = ${2:cond} ? ${3:a} : ${4:b};"],
		"description": "三目赋值"
	},

	"Two stage synchronizer": {
		"prefix": "sync2",
		"body": [
			"reg ${1:sig}_d1, ${1:sig}_d2;",
			"always @(posedge ${2:clk} or negedge ${3:rst_n}) begin",
			"\tif (!${3:rst_n}) begin",
			"\t\t${1:sig}_d1 <= 1'b0;",
			"\t\t${1:sig}_d2 <= 1'b0;",
			"\tend else begin",
			"\t\t${1:sig}_d1 <= ${1:sig};",
			"\t\t${1:sig}_d2 <= ${1:sig}_d1;",
			"\tend",
			"end"
		],
		"description": "两级同步器 · 跨时钟域打两拍"
	},
	"Edge detect": {
		"prefix": "edge",
		"body": [
			"reg ${1:sig}_d;",
			"always @(posedge ${2:clk} or negedge ${3:rst_n}) begin",
			"\tif (!${3:rst_n}) ${1:sig}_d <= 1'b0;",
			"\telse            ${1:sig}_d <= ${1:sig};",
			"end",
			"",
			"wire ${1:sig}_rise =  ${1:sig} & ~${1:sig}_d;",
			"wire ${1:sig}_fall = ~${1:sig} &  ${1:sig}_d;"
		],
		"description": "边沿检测 · 上升沿与下降沿脉冲"
	},
	"Counter": {
		"prefix": "cnt",
		"body": [
			"reg [${1:7}:0] ${2:cnt};",
			"always @(posedge ${3:clk} or negedge ${4:rst_n}) begin",
			"\tif (!${4:rst_n})               ${2:cnt} <= 0;",
			"\telse if (${2:cnt} == ${5:MAX}) ${2:cnt} <= 0;",
			"\telse                           ${2:cnt} <= ${2:cnt} + 1'b1;",
			"end"
		],
		"description": "计数器 · 到上限自动清零"
	},
	"Shift register": {
		"prefix": "shift",
		"body": [
			"reg [${1:7}:0] ${2:shift_reg};",
			"always @(posedge ${3:clk} or negedge ${4:rst_n}) begin",
			"\tif (!${4:rst_n}) ${2:shift_reg} <= 0;",
			"\telse            ${2:shift_reg} <= {${2:shift_reg}[${1:7}-1:0], ${5:din}};",
			"end"
		],
		"description": "移位寄存器"
	},
	"Pipeline stages": {
		"prefix": "pipe",
		"body": [
			"reg [${1:WIDTH}-1:0] ${2:data}_d1;",
			"reg [${1:WIDTH}-1:0] ${2:data}_d2;",
			"always @(posedge ${3:clk} or negedge ${4:rst_n}) begin",
			"\tif (!${4:rst_n}) begin",
			"\t\t${2:data}_d1 <= 0;",
			"\t\t${2:data}_d2 <= 0;",
			"\tend else begin",
			"\t\t${2:data}_d1 <= ${2:data};",
			"\t\t${2:data}_d2 <= ${2:data}_d1;",
			"\tend",
			"end"
		],
		"description": "流水线打拍 · 两级"
	},
	"Memory array": {
		"prefix": "mem",
		"body": [
			"reg [${1:WIDTH}-1:0] ${2:mem} [0:${3:DEPTH}-1];",
			"",
			"always @(posedge ${4:clk}) begin",
			"\tif (${5:we}) ${2:mem}[${6:waddr}] <= ${7:wdata};",
			"end",
			"",
			"always @(posedge ${4:clk}) begin",
			"\t${8:rdata} <= ${2:mem}[${9:raddr}];",
			"end"
		],
		"description": "存储器 · 同步读写口"
	},

	"Testbench skeleton": {
		"prefix": "tb",
		"body": [
			"`timescale 1ns / 1ps",
			"",
			"module ${1:dut}_tb;",
			"",
			"\treg clk;",
			"\treg rst_n;",
			"\t$0",
			"",
			"\t${1:dut} u_${1:dut} (",
			"\t\t.clk   (clk),",
			"\t\t.rst_n (rst_n)",
			"\t);",
			"",
			"\tinitial begin",
			"\t\tclk = 1'b0;",
			"\t\tforever #5 clk = ~clk;",
			"\tend",
			"",
			"\tinitial begin",
			"\t\trst_n = 1'b0;",
			"\t\t#100;",
			"\t\trst_n = 1'b1;",
			"\tend",
			"",
			"\tinitial begin",
			"\t\t\\$dumpfile(\"${1:dut}_tb.vcd\");",
			"\t\t\\$dumpvars(0, ${1:dut}_tb);",
			"\t\t#10000;",
			"\t\t\\$display(\"Simulation finished at %0t\", \\$time);",
			"\t\t\\$finish;",
			"\tend",
			"",
			"endmodule"
		],
		"description": "测试台骨架 · 时钟 复位 波形 结束"
	},
	"Clock generator": {
		"prefix": "clkgen",
		"body": [
			"reg ${1:clk};",
			"initial begin",
			"\t${1:clk} = 1'b0;",
			"\tforever #${2:5} ${1:clk} = ~${1:clk};",
			"end"
		],
		"description": "时钟产生"
	},
	"Reset generator": {
		"prefix": "rstgen",
		"body": [
			"reg ${1:rst_n};",
			"initial begin",
			"\t${1:rst_n} = 1'b0;",
			"\t#${2:100};",
			"\t${1:rst_n} = 1'b1;",
			"end"
		],
		"description": "复位序列"
	},
	"Waveform dump": {
		"prefix": "dump",
		"body": [
			"initial begin",
			"\t\\$dumpfile(\"${1:wave}.vcd\");",
			"\t\\$dumpvars(0, ${2:tb_top});",
			"end"
		],
		"description": "波形输出"
	},
	"Display": {
		"prefix": "display",
		"body": ["\\$display(\"%0t | ${1:sig} = %h\", \\$time, ${1:sig});"],
		"description": "display 打印"
	},
	"Monitor": {
		"prefix": "monitor",
		"body": ["\\$monitor(\"%0t | ${1:sig} = %h\", \\$time, ${1:sig});"],
		"description": "monitor 监视"
	},
	"Finish": {
		"prefix": "finish",
		"body": [
			"#${1:1000};",
			"\\$finish;"
		],
		"description": "延时后结束仿真"
	},
	"Stop": {
		"prefix": "stop",
		"body": ["\\$stop;"],
		"description": "暂停仿真 · 可在交互中继续"
	},
	"Random value": {
		"prefix": "random",
		"body": ["${1:data} = \\$random % ${2:256};"],
		"description": "随机激励 · 取模限制范围"
	},
	"Readmemh": {
		"prefix": "readmemh",
		"body": ["\\$readmemh(\"${1:init}.mem\", ${2:mem});"],
		"description": "十六进制文件初始化存储器"
	},
	"Readmemb": {
		"prefix": "readmemb",
		"body": ["\\$readmemb(\"${1:init}.mem\", ${2:mem});"],
		"description": "二进制文件初始化存储器"
	},
	"File open": {
		"prefix": "fopen",
		"body": [
			"integer ${1:fp};",
			"${1:fp} = \\$fopen(\"${2:file}.txt\", \"${3|r,w,a|}\");",
			"if (${1:fp} == 0) begin",
			"\t\\$display(\"ERROR: cannot open ${2:file}.txt\");",
			"\t\\$finish;",
			"end"
		],
		"description": "打开文件 · 含失败检查，模式可选 r/w/a"
	},
	"File close": {
		"prefix": "fclose",
		"body": ["\\$fclose(${1:fp});"],
		"description": "关闭文件"
	},
	"File write": {
		"prefix": "fwrite",
		"body": [
			"\\$fwrite(${1:fp}, \"%0t | ${2:sig} = %h\\n\", \\$time, ${2:sig});"
		],
		"description": "写入文件 · fwrite 格式化输出"
	},
	"File display": {
		"prefix": "fdisplay",
		"body": [
			"\\$fdisplay(${1:fp}, \"%0t | ${2:sig} = %h\", \\$time, ${2:sig});"
		],
		"description": "写入文件 · fdisplay 自动换行"
	},
	"File scanf": {
		"prefix": "fscanf",
		"body": [
			"integer ${1:code};",
			"${1:code} = \\$fscanf(${2:fp}, \"${3:%h}\", ${4:data});",
			"if (${1:code} != ${5:1}) begin",
			"\t\\$display(\"ERROR at %0t: fscanf failed\", \\$time);",
			"end"
		],
		"description": "读文件 · fscanf 格式化读取并检查返回值"
	},
	"File gets": {
		"prefix": "fgets",
		"body": [
			"reg [8*${1:256}-1:0] ${2:line};",
			"integer ${3:code};",
			"${3:code} = \\$fgets(${2:line}, ${4:fp});",
			"if (${3:code} == 0) begin",
			"\t\\$display(\"EOF or read error\");",
			"end"
		],
		"description": "读文件 · fgets 按行读取"
	},
	"Assert compare": {
		"prefix": "assert",
		"body": [
			"if (${1:actual} !== ${2:expect}) begin",
			"\t\\$display(\"ERROR at %0t: expect %h, got %h\", \\$time, ${2:expect}, ${1:actual});",
			"\terror_cnt = error_cnt + 1;",
			"end"
		],
		"description": "结果比对 · 不符则报错计数"
	},

	"Timescale": {
		"prefix": "timescale",
		"body": ["`timescale ${1:1ns} / ${2:1ps}"],
		"description": "timescale 指令"
	},
	"Define macro": {
		"prefix": "define",
		"body": [
			"`define ${1:NAME} ${2:value}"
		],
		"description": "宏定义"
	},
	"Include file": {
		"prefix": "include",
		"body": [
			"`include \"${1:file}.vh\""
		],
		"description": "包含头文件"
	},
	"Include guard": {
		"prefix": "guard",
		"body": [
			"`ifndef ${1:NAME}_VH",
			"`define ${1:NAME}_VH",
			"",
			"$0",
			"",
			"`endif"
		],
		"description": "头文件 include guard"
	},
	"Ifdef block": {
		"prefix": "ifdef",
		"body": [
			"`ifdef ${1:MACRO}",
			"\t$0",
			"`endif"
		],
		"description": "条件编译 · ifdef"
	},
	"Ifndef block": {
		"prefix": "ifndef",
		"body": [
			"`ifndef ${1:MACRO}",
			"\t$0",
